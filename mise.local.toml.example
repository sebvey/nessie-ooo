# Copy to mise.local.toml (ignored by git) and fill in the values.
[env]
# Nessie branch dbt reads from and writes to (see transformation/working-on-a-branch.md)
NESSIE_BRANCH = "main"

# Postgres credentials of the Nessie version store, read by stack/docker-compose.yml.
# Changing the password needs `mise run stack-reset` (Postgres only reads it on first start).
NESSIE_PG_USER = "nessie"
NESSIE_PG_PASSWORD = "change-me"

# Silo root credentials, read by stack/docker-compose.yml, the demo's clients, dbt and the AWS CLI.
# The password needs at least 8 characters.
AWS_ACCESS_KEY_ID = "silo-admin"
AWS_SECRET_ACCESS_KEY = "change-me"
